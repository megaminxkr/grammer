---
import Layout from '../../layouts/Layout.astro';
import LessonCard from '../../components/LessonCard.astro';
import { chapters } from '../../lib/curriculum';
import { getLessons } from '../../lib/lessons';
import { href } from '../../lib/paths';
export function getStaticPaths() { return chapters.map(chapter => ({ params: { chapter: String(chapter.id) }, props: { chapter } })); }
const { chapter } = Astro.props;
const lessons = (await getLessons()).filter(lesson => lesson.data.chapter === chapter.id);
---
<Layout title={chapter.title} description={chapter.description} wide>
  <div class="page-heading"><p class="breadcrumb"><a href={href()}>ホーム</a> / <a href={href('chapters/')}>カリキュラム</a> / {chapter.title}</p><p class="eyebrow">CHAPTER {String(chapter.id).padStart(2,'0')}</p><h1>{chapter.title}</h1><p>{chapter.description}</p></div>
  {lessons.length ? <div class="lesson-grid">{lessons.map((lesson,index) => <LessonCard lesson={lesson} index={index} />)}</div> : <div class="empty-state"><h2>教材の公開を準備しています</h2><p>人間による校閲を終えた教材から、この章に追加します。</p><a class="text-link" href={href('chapters/')}>学習マップへ戻る →</a></div>}
</Layout>

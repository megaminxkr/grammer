---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import { href } from '../lib/paths';
import { reviewPreview } from '../lib/lessons';
interface Props { title: string; description: string; wide?: boolean }
const { title, description, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | English Grammar Atlas</title><meta name="description" content={description} />
    <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta name="color-scheme" content="light dark" />
    {reviewPreview && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" /><meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={`${title} | English Grammar Atlas`} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(href('og.svg'), Astro.site)} />
    <script is:inline>
      try {
        const theme = localStorage.getItem('ega:theme');
        document.documentElement.dataset.theme = theme === 'dark' || theme === 'light' ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (localStorage.getItem('ega:font') === 'large') document.documentElement.dataset.font = 'large';
      } catch { /* Preferences are optional when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    {reviewPreview && <div class="review-banner" role="note">校閲用プレビュー — 教材は人間による校閲前です。公開ビルドには含まれません。</div>}
    <div class:list={['shell', { 'shell-wide': wide }]}>
      <Sidebar />
      <main id="main" tabindex="-1"><slot /></main>
    </div>
    <footer><span class="footer-brand">English Grammar Atlas</span><span>一つひとつの理解を、確かなつながりに。</span><a href={href('about/')}>教材の公開方針</a></footer>
  </body>
</html>

{
  "name": "english-grammar-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/review.mjs dev",
    "dev:review": "node scripts/review.mjs dev",
    "check": "astro check",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/clean.mjs && npm run validate:content && astro build && node --import tsx scripts/verify-build.ts",
    "build:review": "node scripts/clean.mjs && npm run validate:content && node scripts/review.mjs build && node --import tsx scripts/verify-review.ts",
    "preview": "astro preview",
    "verify": "npm run check && npm run test && npm run build",
    "dev:public": "astro dev --host 0.0.0.0"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
